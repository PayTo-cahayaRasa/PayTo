APP_NAME=PayTo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# =============================================================================
# PRODUCTION SETTINGS - SET THESE BEFORE DEPLOYING!
# =============================================================================
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://yourdomain.com
# =============================================================================

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: use LOG_STACK=daily and LOG_LEVEL=warning (or stderr on container platforms).
# Never log credentials, session identifiers, payment details, or other personal data.

# =============================================================================
# DATABASE - CONFIGURE FOR YOUR ENVIRONMENT
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=payto
DB_USERNAME=root
DB_PASSWORD=

# =============================================================================
# SESSION SECURITY SETTINGS
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
# IMPORTANT: Set to true in production for encrypted session cookies
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# IMPORTANT: Set to true in production (HTTPS required)
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# RajaOngkir Shipping Cost API V2. Never expose this key to the frontend.
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_ORIGIN=
RAJAONGKIR_COURIERS=jne,jnt,sicepat

# Manual storefront payment instructions. Use a public HTTPS URL for the QRIS image.
STOREFRONT_BANK_NAME=
STOREFRONT_BANK_ACCOUNT_NUMBER=
STOREFRONT_BANK_ACCOUNT_NAME=
STOREFRONT_QRIS_IMAGE_URL=
STOREFRONT_PAYMENT_INSTRUCTIONS="Lakukan pembayaran sesuai total pesanan, lalu kirim bukti pembayaran melalui WhatsApp."

# Configurasi laravel nightwatch
NIGHTWATCH_TOKEN=
NIGHTWATCH_IGNORE_MAIL=true
NIGHTWATCH_IGNORE_NOTIFICATIONS=true

# Cahaya Rasa production user seeder. Set actual values only in the server's .env.
SEEDER_CAHAYARASA_CASHIER_EMAIL=
SEEDER_CAHAYARASA_CASHIER_PASSWORD=
SEEDER_CAHAYARASA_CASHIER_PIN=
SEEDER_CAHAYARASA_SUPERVISOR_EMAIL=
SEEDER_CAHAYARASA_SUPERVISOR_PASSWORD=
SEEDER_CAHAYARASA_SUPERVISOR_PIN=
SEEDER_DIMAS_EMAIL=
SEEDER_DIMAS_PASSWORD=
SEEDER_DIMAS_PIN=

# =============================================================================
# SECURITY NOTES:
# 1. Generate APP_KEY with: php artisan key:generate
# 2. For production: APP_DEBUG=false, SESSION_ENCRYPT=true, SESSION_SECURE_COOKIE=true
# 3. Use strong DB_PASSWORD in production
# 4. Set APP_URL with HTTPS for production
# =============================================================================
